msgid "Home ranking teaser"
msgstr "Strona główna: ranking"

#: patterns/home-ranking.php
msgctxt "Pattern description"
msgid "The top five characters from the plugin's ranking block, with a link to the full ranking."
msgstr "Pięć najlepszych postaci z bloku rankingu wtyczki, z linkiem do pełnego rankingu."

#: patterns/home-ranking.php:16
#: patterns/page-ranking.php:14
msgid "Hall of heroes"
msgstr "Galeria bohaterów"

#: patterns/home-ranking.php:17
msgid "Top players"
msgstr "Najlepsi gracze"

#: patterns/home-ranking.php:31
msgid "Full ranking"
msgstr "Pełny ranking"

#: patterns/home-steps.php
msgctxt "Pattern title"
msgid "Home how to start"
msgstr "Strona główna: jak zacząć"

#: patterns/home-steps.php
msgctxt "Pattern description"
msgid "Four numbered steps from account to first login."
msgstr "Cztery ponumerowane kroki od konta do pierwszego logowania."

#: patterns/home-steps.php:14
msgid "Create an account"
msgstr "Załóż konto"

#: patterns/home-steps.php:14
msgid "Register with a login and a password. It takes less than a minute."
msgstr "Zarejestruj się, podając login i hasło. Zajmie to mniej niż minutę."

#: patterns/home-steps.php:15
msgid "Get the game client and unpack it to a folder of your choice."
msgstr "Pobierz klienta gry i rozpakuj go do wybranego folderu."

#: patterns/home-steps.php:16
msgid "Connect"
msgstr "Połącz się"

#: patterns/home-steps.php:16
msgid "Start the launcher or the game; the server address is already set."
msgstr "Uruchom launcher lub grę; adres serwera jest już ustawiony."

#: patterns/home-steps.php:17
msgid "Create a hero"
msgstr "Stwórz bohatera"

#: patterns/home-steps.php:17
msgid "Log in, create a character and step into Lorencia."
msgstr "Zaloguj się, stwórz postać i wejdź do Lorencii."

#: patterns/home-steps.php:22
msgid "How to start"
msgstr "Jak zacząć"

#: patterns/home-steps.php:23
msgid "Four steps to the battlefield"
msgstr "Cztery kroki na pole bitwy"

#: patterns/page-404.php
msgctxt "Pattern title"
msgid "Page not found"
msgstr "Nie znaleziono strony"

#: patterns/page-404.php
msgctxt "Pattern description"
msgid "The 404 screen: a big gold number, a short message, a search field and a way home."
msgstr "Ekran 404: duża złota liczba, krótki komunikat, wyszukiwarka i droga do strony głównej."

#: patterns/page-404.php:17
msgid "The path ends here"
msgstr "Tu kończy się droga"

#: patterns/page-404.php:18
msgid "This page does not exist or has been moved. Try the search, or return to the start."
msgstr "Ta strona nie istnieje albo została przeniesiona. Spróbuj wyszukiwarki lub wróć na start."

#: patterns/page-404.php:19
#: patterns/page-search.php:16
#: patterns/page-search.php:18
#: patterns/posts-list.php:30
msgid "Search"
msgstr "Szukaj"

#: patterns/page-404.php:23
msgid "Back to the home page"
msgstr "Wróć na stronę główną"

#: patterns/page-account.php
msgctxt "Pattern title"
msgid "Account page"
msgstr "Strona konta"

#: patterns/page-account.php
msgctxt "Pattern description"
msgid "Page head and the Account block of the OpenMU WP Connect plugin. Used by the \"account\" page template."
msgstr "Nagłówek strony i blok Konto wtyczki OpenMU WP Connect. Używane przez szablon strony „account”."

#: patterns/page-account.php:14
msgid "Your account"
msgstr "Twoje konto"

#: patterns/page-account.php:14
msgid "Sign in to see your characters, change your password or create a new account."
msgstr "Zaloguj się, aby zobaczyć swoje postacie, zmienić hasło lub założyć nowe konto."

#: patterns/page-archive.php
msgctxt "Pattern title"
msgid "Archive page head"
msgstr "Nagłówek archiwum"

#: patterns/page-archive.php
msgctxt "Pattern description"
msgid "Banner of category, tag, author and date archives (the archive title and description), followed by the posts grid."
msgstr "Baner archiwów kategorii, tagów, autorów i dat (tytuł i opis archiwum), a pod nim siatka wpisów."

#: patterns/page-archive.php:16
msgid "Archive"
msgstr "Archiwum"

#: patterns/page-armory.php
msgctxt "Pattern title"
msgid "Armory page"
msgstr "Strona zbrojowni"

#: patterns/page-armory.php
msgctxt "Pattern description"
msgid "Page head and the Armory block of the OpenMU WP Connect plugin. Used by the \"armory\" page template."
msgstr "Nagłówek strony i blok Zbrojownia wtyczki OpenMU WP Connect. Używane przez szablon strony „armory”."

#: patterns/page-armory.php:14
msgid "Inspect a hero"
msgstr "Obejrzyj bohatera"

#: patterns/page-armory.php:14
msgid "Search a character by name and see its class, level and the items it wears."
msgstr "Wyszukaj postać po nazwie i zobacz jej klasę, poziom i noszone przedmioty."

#: patterns/page-commands.php
msgctxt "Pattern title"
msgid "Commands page"
msgstr "Strona komend"

#: patterns/page-commands.php
msgctxt "Pattern description"
msgid "Page head and a table of the chat commands players use on an OpenMU server. Remove the commands your server has switched off."
msgstr "Nagłówek strony i tabela komend czatu używanych na serwerze OpenMU. Usuń komendy wyłączone na Twoim serwerze."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:16
msgid "/move <map>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:16
msgid "Travels to a map, for example /move devias."
msgstr "Przenosi na mapę, np. /move devias."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:18
msgid "/post <text>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:18
msgid "Sends a message to all players on the server."
msgstr "Wysyła wiadomość do wszystkich graczy na serwerze."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:20
msgid "/world <text>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:20
msgid "Sends a message to the world chat, which players on all game servers can read."
msgstr "Wysyła wiadomość na czat światowy, który czytają gracze ze wszystkich serwerów gry."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:22
msgid "/add <str|agi|vit|ene|cmd> <points>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:22
msgid "Adds level-up points to a stat, for example /add str 10. The last stat is command (Dark Lord)."
msgstr "Dodaje punkty za poziom do statystyki, np. /add str 10. Ostatnia statystyka to dowodzenie (Dark Lord)."

#: patterns/page-commands.php:23
msgid "Resets the character when it reaches the required level."
msgstr "Resetuje postać, gdy osiągnie wymagany poziom."

#: patterns/page-commands.php:24
msgid "Shows the cost and the points granted for your next reset."
msgstr "Pokazuje koszt i punkty przyznawane za następny reset."

#: patterns/page-commands.php:25
msgid "Resets the stat points of your character."
msgstr "Resetuje punkty statystyk postaci."

#: patterns/page-commands.php:26
msgid "Clears your player-killer status for a fee."
msgstr "Zdejmuje status PK za opłatą."

#: patterns/page-commands.php:27
msgid "Keeps your character leveling in the world after you disconnect. The MU Helper must be running."
msgstr "Postać dalej zdobywa poziomy w świecie po rozłączeniu. MU Helper musi być uruchomiony."

#: patterns/page-commands.php:28
msgid "Lists the items that are waiting for free space in your inventory."
msgstr "Pokazuje przedmioty czekające na wolne miejsce w ekwipunku."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:30
msgid "/war <guild>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:30
msgid "Sends a guild war request to the guild master of the given guild."
msgstr "Wysyła prośbę o wojnę gildii do mistrza podanej gildii."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:32
msgid "/battlesoccer <guild>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:32
msgid "Sends a battle soccer request to the guild master of the given guild."
msgstr "Wysyła prośbę o Battle Soccer do mistrza podanej gildii."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:34
msgid "/language <code>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:34
msgid "Changes the language of your account, for example /language pl."
msgstr "Zmienia język konta, np. /language pl."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:36
msgid "/discord <link|unlink|notify>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:36
msgid "Links your account to Discord. /discord link creates a code to enter in Discord, /discord unlink removes the link."
msgstr "Łączy konto z Discordem. /discord link tworzy kod do wpisania na Discordzie, /discord unlink usuwa powiązanie."

#: patterns/page-commands.php:37
msgid "Lists the commands available to you, with their usage."
msgstr "Wypisuje dostępne dla Ciebie komendy wraz z użyciem."

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:39
msgid "/help <command>"
msgstr ""

#. translators: chat command; translate only the placeholder in angle brackets, never the command itself.
#: patterns/page-commands.php:39
msgid "Shows how to use one command, for example /help move."
msgstr "Pokazuje, jak użyć jednej komendy, np. /help move."

#: patterns/page-commands.php:47
msgid "In-game chat"
msgstr "Czat w grze"

#: patterns/page-commands.php:47
msgid "Type these in the game chat. Values in angle brackets are yours to fill in. Some commands may be switched off on this server."
msgstr "Wpisuj je na czacie w grze. Wartości w nawiasach ostrych uzupełnij sam. Niektóre komendy mogą być wyłączone na tym serwerze."

#: patterns/page-commands.php:51
msgid "Command"
msgstr "Komenda"

#: patterns/page-commands.php:51
msgid "What it does"
msgstr "Co robi"

#: patterns/page-download.php
msgctxt "Pattern title"
msgid "Download page"
msgstr "Strona pobierania"

#: patterns/page-download.php
msgctxt "Pattern description"
msgid "Page head, the client download options and the system requirements. Replace the \"#\" links with the real download addresses."
msgstr "Nagłówek strony, opcje pobrania klienta i wymagania systemowe. Podmień linki „#” na prawdziwe adresy pobierania."

#: patterns/page-download.php:15
msgid "Full client for Windows"
msgstr "Pełny klient dla Windows"

#: patterns/page-download.php:15
msgid "Everything in one archive: the game and the launcher. Unpack it and start the launcher."
msgstr "Wszystko w jednym archiwum: gra i launcher. Rozpakuj i uruchom launcher."

#: patterns/page-download.php:15
msgid "Download for Windows"
msgstr "Pobierz dla Windows"

#: patterns/page-download.php:16
msgid "Launcher only"
msgstr "Tylko launcher"

#: patterns/page-download.php:16
msgid "A small program that downloads and updates the game files for you."
msgstr "Mały program, który pobiera i aktualizuje pliki gry za Ciebie."

#: patterns/page-download.php:16
msgid "Download the launcher"
msgstr "Pobierz launcher"

#: patterns/page-download.php:17
msgid "Linux and macOS"
msgstr "Linux i macOS"

