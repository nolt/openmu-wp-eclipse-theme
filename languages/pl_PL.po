msgstr "Następny"

#: blocks/class-showcase/block.json
msgctxt "block title"
msgid "Class showcase"
msgstr "Prezentacja klas"

#: blocks/class-showcase/block.json
msgctxt "block description"
msgid "The three original characters (Dark Knight, Dark Wizard, Fairy Elf) with a class switcher, a short description and rating bars."
msgstr "Trzy oryginalne postacie (Dark Knight, Dark Wizard, Fairy Elf) z przełącznikiem klas, krótkim opisem i paskami ocen."

#: blocks/scene/block.json
msgctxt "block title"
msgid "Eclipse scene"
msgstr "Scena zaćmienia"

#: blocks/scene/block.json
msgctxt "block description"
msgid "The animated eclipse scene: parallax mountains, castle, fog and drifting embers. Place it first inside a full-width group to make a hero."
msgstr "Animowana scena zaćmienia: góry z paralaksą, zamek, mgła i unoszący się żar. Umieść ją jako pierwszą w grupie pełnej szerokości, aby zrobić hero."

#: blocks/site-nav/block.json
msgctxt "block title"
msgid "Site menu"
msgstr "Menu strony"

#: blocks/site-nav/block.json
msgctxt "block description"
msgid "The theme's menu: Home, News, Download, a Server submenu, Account. Built from the pages by their address; works on touch and as a full-screen menu on phones."
msgstr "Menu motywu: Strona główna, Aktualności, Pobierz, podmenu Serwer, Konto. Budowane ze stron po adresie; działa dotykowo i jako pełnoekranowe menu na telefonie."

