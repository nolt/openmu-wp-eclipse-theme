#: patterns/home-classes.php
msgctxt "Pattern title"
msgid "Home class showcase"
msgstr "Strona główna: klasy"

#: patterns/home-classes.php
msgctxt "Pattern description"
msgid "The three original heroes (Dark Knight, Dark Wizard, Fairy Elf) with a class switcher."
msgstr "Trzej oryginalni bohaterowie (Dark Knight, Dark Wizard, Fairy Elf) z przełącznikiem klas."

#: patterns/home-classes.php:16
msgid "Choose your path"
msgstr "Wybierz swoją ścieżkę"

#: patterns/home-classes.php:17
msgid "Three heroes, one fate"
msgstr "Trzech bohaterów, jeden los"

#: patterns/home-classes.php:18
msgid "Every legend begins with a choice. Pick a class and grow it through the quest line into a master of its craft."
msgstr "Każda legenda zaczyna się od wyboru. Wybierz klasę i rozwiń ją przez linię questów w mistrza swojego fachu."

#: patterns/home-cta.php
msgctxt "Pattern title"
msgid "Download and Discord call to action"
msgstr "Wezwanie: pobierz i Discord"

#: patterns/home-cta.php
msgctxt "Pattern description"
msgid "A closing panel with a glowing eclipse: download button and a link to the community Discord. Replace the Discord link with your invitation."
msgstr "Zamykający panel ze świecącym zaćmieniem: przycisk pobierania i link do Discorda społeczności. Podmień link na swoje zaproszenie."

#: patterns/home-cta.php:18
msgid "Your legend starts today"
msgstr "Twoja legenda zaczyna się dziś"

#: patterns/home-cta.php:19
msgid "Download the client, join the community on Discord and meet the players waiting for you on the battlefield."
msgstr "Pobierz klienta, dołącz do społeczności na Discordzie i poznaj graczy, którzy czekają na polu bitwy."

#: patterns/home-cta.php:23
#: patterns/home-steps.php:15
msgid "Download the client"
msgstr "Pobierz klienta"

#: patterns/home-cta.php:26
msgid "Join Discord"
msgstr "Dołącz do Discorda"

#: patterns/home-events.php
msgctxt "Pattern title"
msgid "Home events teaser"
msgstr "Strona główna: wydarzenia"

#: patterns/home-events.php
msgctxt "Pattern description"
msgid "The next game events from the plugin's events block, with a link to the full schedule."
msgstr "Najbliższe wydarzenia z bloku wydarzeń wtyczki, z linkiem do pełnego harmonogramu."

#: patterns/home-events.php:16
#: patterns/page-events.php:14
msgid "Never miss a battle"
msgstr "Nie przegap bitwy"

#: patterns/home-events.php:17
msgid "Upcoming events"
msgstr "Nadchodzące wydarzenia"

#: patterns/home-events.php:31
msgid "Full schedule"
msgstr "Pełny harmonogram"

#: patterns/home-hero.php
msgctxt "Pattern title"
msgid "Home hero"
msgstr "Strona główna: hero"

#: patterns/home-hero.php
msgctxt "Pattern description"
msgid "Full-screen hero with the animated eclipse scene, headline, call-to-action buttons and the live server status."
msgstr "Hero na cały ekran z animowaną sceną zaćmienia, nagłówkiem, przyciskami akcji i statusem serwera na żywo."

#: patterns/home-hero.php:22
msgid "Season 6 · Free to play"
msgstr "Season 6 · Za darmo"

#: patterns/home-hero.php:23
msgid "Rise beneath the eclipse"
msgstr "Powstań pod zaćmieniem"

#. translators: %s: site name.
#: patterns/home-hero.php:30
#, php-format
msgid "The sun has gone dark over the old continent. Take up the blade, the staff or the bow and write your legend on %s."
msgstr "Słońce zgasło nad starym kontynentem. Chwyć miecz, kostur lub łuk i zapisz swoją legendę na %s."

#: patterns/home-hero.php:43
msgid "Create account"
msgstr "Załóż konto"

#: patterns/home-news.php
msgctxt "Pattern title"
msgid "Home latest news"
msgstr "Strona główna: aktualności"

#: patterns/home-news.php
msgctxt "Pattern description"
msgid "The three latest posts as cards, with a link to all news."
msgstr "Trzy najnowsze wpisy jako karty, z linkiem do wszystkich aktualności."

#: patterns/home-news.php:16
msgid "From the realm"
msgstr "Z królestwa"

#: patterns/home-news.php:17
msgid "Latest news"
msgstr "Najnowsze aktualności"

#: patterns/home-news.php:24
msgid "No news yet. The first announcement is coming soon."
msgstr "Brak aktualności. Pierwsze ogłoszenie już wkrótce."

#: patterns/home-news.php:31
msgid "All news"
msgstr "Wszystkie aktualności"

#: patterns/home-ranking.php
